imports:
- from: ../layouts/stage.layout.dawn
  as: layouts
- from: ../patches/house.patch.dawn
  as: patches
main:
  type: display
  layout: layouts.stage
  patch: patches.house
  controllers:
  - wall_controller
  - floor_controller
wall_controller:
  type: controller
  protocol: artnet
  output:
    type: patched_dmx
    channel_order: rgb
    universes:
    - id: 1
      range: 1..510
    - id: 2
      range: 1..510
floor_controller:
  type: controller
  protocol: sacn
  output:
    type: patched_dmx
    channel_order: rgb
    universes:
    - id: 11
      range: 1..510
    - id: 12
      range: 1..510
