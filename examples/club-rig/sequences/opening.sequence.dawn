imports:
- from: ../effects
  as: effects
- from: ../curves
  as: curves
opening:
  type: sequence
  duration: 200s
  frame_rate: 144
  audio: ../audio/song.mp3
  mark_collections:
  - key: marks
    name: Group 1
    color: '#38bdf8'
    marks:
    - 12.549s
    - 13.62s
    - 15.167s
    - 16.459s
    - 40.022s
    - 40.137s
    - 40.336s
    - 40.538s
    - 40.635s
    - 40.832s
    - 40.943s
    - 41.134s
    - 41.334s
    - 41.435s
    - 42.711s
    - 42.769s
    - 42.825s
    - 42.936s
    - 43.134s
    - 43.336s
    - 43.434s
    - 43.633s
    - 43.736s
    - 129.633s
    - 129.766s
    - 129.902s
    - 130.034s
    - 130.165s
    - 130.302s
    - 130.431s
    - 130.567s
    - 130.701s
    - 130.833s
    - 130.97s
    - 131.1s
  effects:
  - id: 23
    start: 1.517s
    duration: 8.25s
    target:
      type: fixture
      id: 1
    scope: per_fixture
    params:
      base:
        type: color
        value: '#ff1827'
      accent:
        type: color
        value: '#66e3ff'
      speed:
        type: float
        value: 0.5
      fade:
        type: curve
        curve:
          id: 1
          curve: curves.fade_in
    script: effects.Pulse
  - id: 1
    start: 4.283s
    duration: 8.25s
    target:
      type: fixture
      id: 11
    scope: per_fixture
    params:
      base:
        type: color
        value: '#ff1827'
      accent:
        type: color
        value: '#11ff00'
      speed:
        type: float
        value: 0.5
      fade:
        type: curve
        curve:
          id: 1
          curve: curves.fade_in
    script: effects.Pulse
  - id: 24
    start: 11.7s
    duration: 5.4s
    target:
      type: fixture
      id: 4
    scope: per_fixture
    params:
      beats:
        type: marks
        key: marks
      base:
        type: color
        value: '#000000'
      accent:
        type: color
        value: '#ffaa00'
    script: effects.MarkPulse
  - id: 25
    start: 39.768s
    duration: 4.35s
    target:
      type: group
      id: 1
    scope: whole_target
    params:
      beats:
        type: marks
        key: marks
      base:
        type: color
        value: '#000000'
      accent:
        type: color
        value: '#ffd480'
      offset_seconds:
        type: float
        value: -0.07
      decay_seconds:
        type: float
        value: 0.2
      section_width_pixels:
        type: integer
        value: 15
      section_edge_fade_pixels:
        type: float
        value: 1.0
      sections_per_mark:
        type: integer
        value: 8
      seed:
        type: float
        value: 0.0
    script: effects.MarkPulse
  - id: 2
    start: 129.488s
    duration: 1.8s
    target:
      type: group
      id: 1
    scope: whole_target
    params:
      beats:
        type: marks
        key: marks
      base:
        type: color
        value: '#000000'
      accent:
        type: color
        value: '#ffcc66'
      offset_seconds:
        type: float
        value: -0.07
      decay_seconds:
        type: float
        value: 0.18
      section_width_pixels:
        type: integer
        value: 17
      section_edge_fade_pixels:
        type: float
        value: 0.0
      sections_per_mark:
        type: integer
        value: 7
      seed:
        type: float
        value: 0.0
    script: effects.MarkPulse
  automation_clips:
  - id: 101
    start: 0s
    duration: 8s
    curve:
      id: 1
      curve: curves.fade_in
    targets:
    - 1
