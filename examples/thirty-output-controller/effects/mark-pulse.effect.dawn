effect MarkPulse {
  param marks beats;
  param color base = #000000;
  param gradient accent;
  param curve hue;
  param float hue_mix = 0.35;
  param float offset_seconds = 0.0;
  param float decay_seconds = 0.18;
  param int section_width_pixels = 5;
  param float section_edge_fade_pixels = 0.0;
  param int sections_per_mark = 3;
  param float seed = 0.0;

  void generate() {
    TargetItems items = sections(target, section_width_pixels);
    int section_count = count(items);
    if (section_count > 0) {
      for (int mark = 0; mark < mark_count(beats); mark = mark + 1) {
        float hit_time = mark_at(beats, mark, -999.0);
        for (int i = 0; i < sections_per_mark; i = i + 1) {
          float choice = floor(rand(seed + hit_time * 1000.0, i) * section_count);
          timeline.emit MarkPulseChild {
            start: hit_time + offset_seconds,
            duration: max(0.000000001, decay_seconds),
            target: pick(items, choice),
            base: base,
            accent: accent,
            hue: hue,
            hue_mix: hue_mix,
            section_width_pixels: section_width_pixels,
            section_edge_fade_pixels: section_edge_fade_pixels,
            parent_duration: duration,
            child_start: hit_time + offset_seconds
          };
        }
      }
    }
  }
}

effect MarkPulseChild {
  param color base = #000000;
  param gradient accent;
  param curve hue;
  param float hue_mix = 0.35;
  param int section_width_pixels = 5;
  param float section_edge_fade_pixels = 0.0;
  param float parent_duration = 1.0;
  param float child_start = 0.0;

  color sample() {
    float width = max(1.0, section_width_pixels);
    float pixel = pixel_index();
    float choice = floor(pixel / width);
    float edge_fade = max(0.0, section_edge_fade_pixels);
    float active = 1.0;
    if (edge_fade > 0.0) {
      float section_start = choice * width;
      float section_end = min(section_start + width - 1.0, pixel_count() - 1.0);
      float edge_distance = min(pixel - section_start, section_end - pixel);
      active = clamp(edge_distance / edge_fade, 0.0, 1.0);
    }

    float pulse_progress = clamp(progress(), 0.0, 1.0);
    float pulse = 1.0 - pulse_progress;
    float parent_progress = clamp((child_start + seconds()) / max(0.000000001, parent_duration), 0.0, 1.0);
    color pulse_color = mix(accent[pulse_progress], hsv(hue[parent_progress] / 360.0, 1.0, 1.0), clamp(hue_mix, 0.0, 1.0));
    return mix(base, pulse_color, active * pulse);
  }
}
