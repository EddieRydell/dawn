use "./chase.effect.dawn" as effects;

effect MarkChase {
  param marks beats;
  param color base = #000000;
  param enum gradient_mode { through_effect, across_items, per_pulse } = per_pulse;
  param array<curve<color>> gradients;
  param curve<float> hue;
  param float hue_mix = 0.35;
  param float offset_seconds = 0.0;
  param float chase_seconds = 0.5;
  param float pulse_overlap = 8.0;
  param int section_width_pixels = 5;
  param array<curve<float>> chase_positions;
  param curve<float> pulse_shape;

  void generate(Timeline timeline, Target target, float duration) {
    int beat_count = mark_count(beats);
    int gradient_count = len(gradients);
    int chase_position_count = len(chase_positions);
    if (gradient_count > 0 && chase_position_count > 0) {
      for (int beat = 0; beat < beat_count; beat = beat + 1) {
        float hit = mark_at(beats, beat, 0.0) + offset_seconds;
        if (hit >= 0.0 && hit < duration) {
          timeline.emit effects.Chase {
            target: target;
            start: hit;
            duration: chase_seconds;
            params: {
              gradient: gradients[beat % gradient_count];
              gradient_mode: gradient_mode;
              pulse_overlap: pulse_overlap;
              section_width_pixels: section_width_pixels;
              reverse: false;
              chase_position: chase_positions[beat % chase_position_count];
              pulse_shape: pulse_shape;
            };
          };
        }
      }
    }
  }
}
