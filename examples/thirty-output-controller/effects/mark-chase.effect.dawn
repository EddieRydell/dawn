effect MarkChase {
  param marks beats;
  param color base = #000000;
  param enum gradient_mode { through_effect, across_items, per_pulse } = per_pulse;
  param array<curve<color>> gradients;
  param curve<float> hue;
  param float hue_mix = 0.35;
  param float offset_seconds = 0.0;
  param float chase_seconds = 0.5;
  param float pulse_overlap = 8.0;
  param int section_width_pixels = 5;
  param array<curve<float>> chase_positions;
  param curve<float> pulse_shape;

  color sample() {
    int gradient_count = len(gradients);
    int chase_position_count = len(chase_positions);
    if (gradient_count <= 0 || chase_position_count <= 0) {
      return base;
    }

    float query_time = seconds() - offset_seconds;
    int beat = mark_prev_index(beats, query_time);
    if (beat < 0) {
      return base;
    }

    float hit_time = mark_at(beats, beat, -999.0);
    float local_progress = clamp((query_time - hit_time) / max(0.000000001, chase_seconds), 0.0, 1.0);
    float width = max(1.0, section_width_pixels);
    float section_position_value = section_position(section_width_pixels);
    float travel_start = 0.0 - pulse_overlap / max(1.0, pixel_count());
    float travel_end = 1.0 + pulse_overlap / max(1.0, pixel_count());
    float chase = mix(travel_start, travel_end, clamp(chase_positions[beat % chase_position_count][local_progress], 0.0, 1.0));
    float distance = abs(pixel_fraction() - chase);
    float pulse_duration = max(0.000000001, pulse_overlap / max(1.0, pixel_count()));
    float pulse_progress = distance / pulse_duration;
    float level = pulse_shape[clamp(pulse_progress, 0.0, 1.0)];

    float gradient_position = local_progress;
    if (gradient_mode == across_items) {
      gradient_position = pixel_fraction();
    }
    if (gradient_mode == per_pulse) {
      gradient_position = section_position_value;
    }

    color value = curve_color_scaled(gradients[beat % gradient_count], clamp(gradient_position, 0.0, 1.0), level);
    color hue_color = hsv(hue[progress()], 1.0, 1.0);
    return mix(base, mix(value, hue_color, clamp(hue_mix, 0.0, 1.0)), level);
  }
}
