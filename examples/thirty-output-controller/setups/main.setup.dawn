imports:
- from: ../layouts/outputs.layout.dawn
  as: layouts
- from: ../patches/outputs.patch.dawn
  as: patches
main:
  type: setup
  layout: layouts.outputs
  patch: patches.outputs
  controllers:
  - output_controller
output_controller:
  type: controller
  protocol: sacn
  destination: 192.168.7.2:5568
  output:
    channel_order: grb
    type: linear_rgb
    output_count: 30
    pixels_per_output: 113
    first_universe: 1
