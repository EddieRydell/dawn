imports:
- from: ../layouts/outputs.layout.dawn
  as: layouts
- from: ../patches/outputs.patch.dawn
  as: patches
main:
  type: display
  controllers:
  - output_controller
  patch: patches.outputs
  layout: layouts.outputs
output_controller:
  type: controller
  protocol: sacn
  destination: 192.168.7.2:5568
  output:
    type: linear_rgb
    channel_order: grb
    group: 1
    output_count: 30
    pixels_per_output: 113
    first_universe: 1
    slots_per_universe: 510
