imports:
- from:
    documents:
    - display/pixel.prop.dawn
  as: props
elements:
  type: element_tree
  roots:
  - 1
  nodes:
  - id: 1
    name: Pixel
    type: color
    cells: 1
    capability:
      type: rgb
preview:
  type: preview_layout
  element_tree: elements
  props:
  - id: 1
    name: Pixel
    prop: props.pixel
    transform:
      position:
        x: 0.0
        y: 0.0
        z: 0.0
      rotation:
        x: 0.0
        y: 0.0
        z: 0.0
      scale:
        x: 1.0
        y: 1.0
        z: 1.0
    bindings:
    - node: 1
      cell: 0
