imports:
- from:
    documents:
    - display/main.display.dawn
  as: display
- from:
    documents:
    - setups/main.setup.dawn
  as: setups
main:
  type: patch
  nodes:
  - id: 1
    type: source
    selection:
      tree: display.elements
      node: 1
    output: color
    width: 1
  - id: 2
    type: filter
    filter: color_breakdown
    capability:
      type: rgb
    cell_count: 1
  - id: 3
    type: filter
    filter: quantize_8
    width: 3
  - id: 4
    type: sink
    controller: setups.output_controller
    port: 1
    start_slot: 0
    slot_count: 3
  edges:
  - from: 1
    from_port: 0
    to: 2
    to_port: 0
  - from: 2
    from_port: 0
    to: 3
    to_port: 0
  - from: 3
    from_port: 0
    to: 4
    to_port: 0
