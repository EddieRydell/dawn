imports:
- from: ../effects
  as: effects
christmas:
  type: sequence
  duration: 45s
  frame_rate: 60
  audio: null
  mark_collections:
  - key: marks
    name: Marks1
    color: '#00b3ff'
    marks:
    - 12.844s
  - key: marks_2
    name: Marks2
    color: '#f97316'
    marks:
    - 30.5s
    - 34.712s
  - key: marks_3
    name: Marks3
    color: '#22c55e'
    marks:
    - 9.579s
    - 17.176s
    - 21.47s
  layers:
  - id: 0
    name: Default
    color: '#50a0ff'
    enabled: true
  effects:
  - id: 1
    layer_id: 0
    start: 0s
    duration: 45s
    target:
      type: group
      id: 1
    scope: per_fixture
    params:
      first:
        type: color
        value: '#ff2020'
      second:
        type: color
        value: '#fff7d6'
      stripe_pixels:
        type: integer
        value: 8
      speed:
        type: float
        value: 1.0
    script: effects.CandyCane
  - id: 2
    layer_id: 0
    start: 0s
    duration: 45s
    target:
      type: group
      id: 2
    scope: whole_target
    params:
      low:
        type: color
        value: '#1c2c10'
      high:
        type: color
        value: '#ffd27a'
      speed:
        type: float
        value: 0.3
    script: effects.WarmGlow
  - id: 3
    layer_id: 0
    start: 0s
    duration: 45s
    target:
      type: group
      id: 3
    scope: whole_target
    params:
      base:
        type: color
        value: '#0b3d16'
      sparkle:
        type: color
        value: '#f8fff0'
      density:
        type: float
        value: 0.42
      speed:
        type: float
        value: 2.0
      seed:
        type: float
        value: 12.0
    script: effects.Twinkle
  - id: 4
    layer_id: 0
    start: 0s
    duration: 45s
    target:
      type: group
      id: 4
    scope: per_fixture
    params:
      low:
        type: color
        value: '#4aa234'
      high:
        type: color
        value: '#ffdf70'
      speed:
        type: float
        value: 0.9
    script: effects.WarmGlow
  - id: 5
    layer_id: 0
    start: 8.5s
    duration: 24.3s
    target:
      type: fixture
      id: 5
    scope: per_fixture
    params:
      intensity:
        type: curve
        curve:
          id: 1
          curve:
            points:
            - position: 0.0
              value: 1.0
            - position: 1.0
              value: 0.0
      gradient:
        type: gradient
        gradient:
          id: 2
          gradient:
            stops:
            - position: 0.0
              color: '#ffffff'
            - position: 0.231
              color: '#ff7a7a'
            - position: 0.448
              color: '#ff0000'
      spatial_offset:
        type: float
        value: 0.0
    script: effects.CurveGradient
  composition_graph:
    nodes:
    - id: 1
      type: layer
      layer_id: 0
      position:
        x: 80.0
        y: 120.0
    - id: 2
      type: output
      position:
        x: 720.0
        y: 120.0
    edges:
    - from: 1
      from_port: output
      to: 2
      to_port: input
  automation_clips: []
