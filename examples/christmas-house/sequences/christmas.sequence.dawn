imports:
- from: ../effects
  as: effects
christmas:
  type: sequence
  duration: 45s
  frame_rate: 60
  audio: null
  mark_collections:
  - key: marks
    name: Marks1
    color: '#00b3ff'
    marks:
    - 12.844s
  - key: marks_2
    name: Marks2
    color: '#f97316'
    marks:
    - 30.5s
    - 34.712s
  - key: marks_3
    name: Marks3
    color: '#22c55e'
    marks:
    - 9.579s
    - 17.176s
    - 21.47s
  clips:
  - id: 1
    type: effect
    start: 0s
    duration: 45s
    target:
      type: group
      id: 1
    scope: per_fixture
    params:
      first:
        type: color
        value: '#ff2020'
      second:
        type: color
        value: '#fff7d6'
      stripe_pixels:
        type: integer
        value: 8
      speed:
        type: float
        value: 1.0
    script: effects.CandyCane
  - id: 2
    type: effect
    start: 0s
    duration: 45s
    target:
      type: group
      id: 2
    scope: whole_target
    params:
      low:
        type: color
        value: '#1c2c10'
      high:
        type: color
        value: '#ffd27a'
      speed:
        type: float
        value: 0.3
    script: effects.WarmGlow
  - id: 3
    type: effect
    start: 0s
    duration: 45s
    target:
      type: group
      id: 3
    scope: whole_target
    params:
      base:
        type: color
        value: '#0b3d16'
      sparkle:
        type: color
        value: '#f8fff0'
      density:
        type: float
        value: 0.42
      speed:
        type: float
        value: 2.0
      seed:
        type: float
        value: 12.0
    script: effects.Twinkle
  - id: 4
    type: effect
    start: 0s
    duration: 45s
    target:
      type: group
      id: 4
    scope: per_fixture
    params:
      low:
        type: color
        value: '#4aa234'
      high:
        type: color
        value: '#ffdf70'
      speed:
        type: float
        value: 0.9
    script: effects.WarmGlow
  - id: 5
    type: effect
    start: 8.5s
    duration: 24.3s
    target:
      type: fixture
      id: 5
    scope: per_fixture
    params:
      intensity:
        type: curve
        curve:
          id: 1
          curve:
            value_type: float
            points:
            - time: 0.0
              value: 1.0
            - time: 1.0
              value: 0.0
      gradient:
        type: curve
        curve:
          id: 2
          curve:
            value_type: color
            points:
            - time: 0.0
              value: '#ffffff'
            - time: 0.231
              value: '#ff7a7a'
            - time: 0.448
              value: '#ff0000'
      spatial_offset:
        type: float
        value: 0.0
    script: effects.CurveGradient
  automation_clips: []
