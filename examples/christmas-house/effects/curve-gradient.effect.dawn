effect CurveGradient {
  param curve intensity;
  param gradient gradient;
  param float spatial_offset = 0.0;

  color sample() {
    float position = pixel_fraction();

    float gradient_position = clamp(progress() + position * spatial_offset, 0.0, 1.0);
    float level = curve_clamped(intensity, progress(), 0.0, 1.0);
    return gradient_color_scaled(gradient, gradient_position, level);
  }
}
