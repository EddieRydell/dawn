imports:
- from: ../effects
  as: effects
- from: ../curves
  as: curves
example:
  type: sequence
  duration: 120s
  frame_rate: 144
  mark_collections:
  - key: marks
    name: Marks
    color: '#38bdf8'
    marks: []
  layers:
  - id: 0
    name: Default
    color: '#50a0ff'
    enabled: true
  effects: []
  composition_graph:
    nodes:
    - id: 1
      type: layer
      layer_id: 0
      position:
        x: 80.0
        y: 120.0
    - id: 2
      type: output
      position:
        x: 720.0
        y: 120.0
    edges:
    - from: 1
      from_port: output
      to: 2
      to_port: input
  automation_clips: []
