warm_gradient:
  type: gradient
  stops:
  - position: 0.0
    color: '#fff4d6'
  - position: 0.35
    color: '#ffb000'
  - position: 1.0
    color: '#ff2a00'
cool_gradient:
  type: gradient
  stops:
  - position: 0.0
    color: '#d9ffff'
  - position: 0.45
    color: '#00a6ff'
  - position: 1.0
    color: '#3d00ff'
club_gradient:
  type: gradient
  stops:
  - position: 0.0
    color: '#ffffff'
  - position: 0.25
    color: '#ff2bd6'
  - position: 0.6
    color: '#2de2ff'
  - position: 1.0
    color: '#7cff00'
fire_gradient:
  type: gradient
  stops:
  - position: 0.0
    color: '#ffffff'
  - position: 0.18
    color: '#ffd15c'
  - position: 0.55
    color: '#ff4a00'
  - position: 1.0
    color: '#1a0000'
